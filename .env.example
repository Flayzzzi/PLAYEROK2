# Create a Telegram bot with @BotFather and paste its token here.
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE

# Your numeric Telegram user ID. Only this ID can use the panel.
# Get it from a trusted ID-check bot, then put the number here.
ADMIN_IDS=123456789

# Optional: data directory. Defaults to ./data
DATA_DIR=./data

# Keep disabled until a supported, compliant Playerok integration is configured.
PLAYEROK_INTEGRATION_ENABLED=false
